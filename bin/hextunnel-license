#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

STATE_DIR="${HEXTUNNEL_LICENSE_STATE_DIR:-/etc/hextunnel}"
STATE_FILE="$STATE_DIR/license-state.env"
TOKEN_FILE="$STATE_DIR/activation.token"
PUBLIC_KEY_FILE="${HEXTUNNEL_LICENSE_PUBLIC_KEY_FILE:-$STATE_DIR/license-public.pem}"
LOCK_FILE="${HEXTUNNEL_LICENSE_LOCK_FILE:-/run/lock/hextunnel-license.lock}"
LEASE_ENDPOINT="${HEXTUNNEL_LEASE_ENDPOINT:-https://ghostdeveloperkeys.duckdns.org/api/v1/licenses/lease}"
PUBLIC_KEY_URL="${HEXTUNNEL_LICENSE_PUBLIC_KEY_URL:-https://ghostdeveloperkeys.duckdns.org/.well-known/hextunnel-license-public.pem}"
PUBLIC_KEY_SHA256="${HEXTUNNEL_LICENSE_PUBLIC_KEY_SHA256:-804f9b029d39dd9c9ba4246bcecf3cd9963a5555491f7da8dfc3cc6d24f6ec3e}"
DEFAULT_RESELLER="Hex Tunnel Bot Gen"

fail(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }

remaining_time(){
  local value="$1" now target seconds days hours minutes
  target="$(date -d "$value" +%s 2>/dev/null)" || { printf 'desconocido'; return; }
  now="$(date -u +%s)"
  seconds=$((target-now))
  ((seconds > 0)) || { printf 'vencida'; return; }
  days=$((seconds/86400)); hours=$(((seconds%86400)/3600)); minutes=$(((seconds%3600)/60))
  printf '%dd %02dh %02dm' "$days" "$hours" "$minutes"
}

load_state(){
  [[ -r "$STATE_FILE" ]] || fail "No existe una activación local."
  # shellcheck disable=SC1090
  source "$STATE_FILE"
  HEXTUNNEL_KEY_EXPIRES_AT="${HEXTUNNEL_KEY_EXPIRES_AT:-${HEXTUNNEL_LICENSE_EXPIRES_AT:-desconocido}}"
  HEXTUNNEL_INSTALLATION_PERMANENT="${HEXTUNNEL_INSTALLATION_PERMANENT:-0}"
  HEXTUNNEL_RESELLER="${HEXTUNNEL_RESELLER:-$DEFAULT_RESELLER}"
}

show_status(){
  load_state
  printf 'Hex Tunnel — Activación\n'
  printf 'Estado: %s\n' "$([[ "$HEXTUNNEL_INSTALLATION_PERMANENT" == 1 ]] && printf 'permanente' || printf 'heredado')"
  printf 'Versión instalada: %s\n' "${HEXTUNNEL_INSTALLED_VERSION:-desconocida}"
  printf 'IP vinculada: %s\n' "${HEXTUNNEL_LICENSE_SUBJECT:-desconocida}"
  printf 'Activada: %s\n' "${HEXTUNNEL_ACTIVATED_AT:-desconocido}"
  printf 'Reseller: %s\n' "$HEXTUNNEL_RESELLER"
  printf 'La key vencía sin usar: %s\n' "$HEXTUNNEL_KEY_EXPIRES_AT"
  printf 'Lease vigente hasta: %s\n' "${HEXTUNNEL_LEASE_EXPIRES_AT:-desconocido}"
  printf 'Última operación: %s\n' "${HEXTUNNEL_LAST_OPERATION:-desconocida}"
  printf 'La fecha de la key es informativa después de activarse; la instalación solo termina por revocación.\n'
}

show_reseller(){
  load_state
  printf '%s\n' "$HEXTUNNEL_RESELLER"
}

verify_public_key(){
  local path="$1" actual
  [[ -s "$path" ]] || return 1
  actual="$(sha256sum "$path" | awk '{print tolower($1)}')"
  [[ "$actual" == "${PUBLIC_KEY_SHA256,,}" ]] || return 1
  openssl pkey -pubin -in "$path" -noout >/dev/null 2>&1
}

prepare_public_key(){
  local work downloaded
  if verify_public_key "$PUBLIC_KEY_FILE"; then
    printf '%s' "$PUBLIC_KEY_FILE"
    return 0
  fi
  work="$(mktemp -d /tmp/hextunnel-license-key.XXXXXX)"
  downloaded="$work/license-public.pem"
  if ! curl -fsSL --retry 2 --connect-timeout 8 --max-time 20 "$PUBLIC_KEY_URL" -o "$downloaded"; then
    rm -rf "$work"
    fail "No se pudo obtener la clave pública y no existe una copia local válida."
  fi
  verify_public_key "$downloaded" || {
    rm -rf "$work"
    fail "La clave pública descargada no coincide con el hash fijado."
  }
  install -d -m 700 "$STATE_DIR"
  install -m 600 "$downloaded" "$PUBLIC_KEY_FILE.new"
  mv -f "$PUBLIC_KEY_FILE.new" "$PUBLIC_KEY_FILE"
  rm -rf "$work"
  printf '%s' "$PUBLIC_KEY_FILE"
}

atomic_update_lease(){
  local lease="$1" work
  work="$(mktemp "$STATE_DIR/.license-state.XXXXXX")"
  awk '!/^HEXTUNNEL_LEASE_EXPIRES_AT=/' "$STATE_FILE" > "$work"
  printf 'HEXTUNNEL_LEASE_EXPIRES_AT=%q\n' "$lease" >> "$work"
  chmod 600 "$work"
  chown root:root "$work" 2>/dev/null || true
  mv -f "$work" "$STATE_FILE"
}

renew_lease(){
  [[ "${EUID:-$(id -u)}" -eq 0 ]] || fail "La renovación requiere root."
  for command in curl jq openssl sha256sum flock; do
    command -v "$command" >/dev/null 2>&1 || fail "$command no está instalado."
  done
  [[ -s "$TOKEN_FILE" ]] || fail "No existe activation.token."
  install -d -m 755 "$(dirname "$LOCK_FILE")"
  exec 9>"$LOCK_FILE"
  flock -w 30 9 || fail "Otra renovación o actualización está en curso."
  load_state
  [[ "$HEXTUNNEL_INSTALLATION_PERMANENT" == 1 ]] || fail "La activación local no está marcada como permanente."

  local token ip response status lease subject product activation_id signature
  local tmp public_key payload signature_file epoch request_file response_file http_status api_detail
  token="$(tr -d '\r\n' < "$TOKEN_FILE")"
  ip="$(curl -4fsS --retry 2 --connect-timeout 8 --max-time 15 https://api.ipify.org)" \
    || fail "No se pudo detectar la IP pública."

  tmp="$(mktemp -d /tmp/hextunnel-lease.XXXXXX)"
  trap 'rm -rf "${tmp:-}"' EXIT
  request_file="$tmp/request.json"
  response_file="$tmp/response.json"
  chmod 700 "$tmp"
  jq -n --arg token "$token" --arg ip "$ip" \
    '{activation_token:$token,ip:$ip,product:"hextunnel"}' > "$request_file"
  : > "$response_file"
  chmod 600 "$request_file" "$response_file"

  if ! http_status="$(curl -sS --retry 2 --connect-timeout 8 --max-time 25 \
    -H 'Accept: application/json' -H 'Content-Type: application/json' \
    --data-binary "@$request_file" -o "$response_file" -w '%{http_code}' \
    "$LEASE_ENDPOINT")"; then
    fail "No se pudo renovar la activación."
  fi
  response="$(cat "$response_file")"
  if [[ ! "$http_status" =~ ^2[0-9]{2}$ ]]; then
    api_detail="$(jq -r '.detail // empty' <<< "$response" 2>/dev/null || true)"
    [[ -n "$api_detail" ]] || api_detail="solicitud rechazada"
    fail "No fue posible renovar: ${api_detail}."
  fi
  jq empty <<< "$response" >/dev/null 2>&1 || fail "Se recibió una respuesta inválida."

  status="$(jq -r '.status // empty' <<< "$response")"
  lease="$(jq -r '.lease_expires_at // empty' <<< "$response")"
  subject="$(jq -r '.subject // empty' <<< "$response")"
  product="$(jq -r '.product // empty' <<< "$response")"
  activation_id="$(jq -r '.activation_id // empty' <<< "$response")"
  signature="$(jq -r '.signature // empty' <<< "$response")"
  [[ "$status" == active && "$subject" == "$ip" && "$product" == hextunnel ]] || fail "La renovación no corresponde a esta máquina."
  [[ "$activation_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "La respuesta contiene un identificador inválido."
  epoch="$(date -d "$lease" +%s 2>/dev/null)" || fail "La respuesta contiene una fecha inválida."
  ((epoch > $(date -u +%s))) || fail "La renovación recibida ya expiró."

  public_key="$(prepare_public_key)"
  payload="$tmp/payload"
  signature_file="$tmp/signature"
  printf 'status=%s\nlease_expires_at=%s\nsubject=%s\nproduct=%s\nactivation_id=%s\n' \
    "$status" "$lease" "$subject" "$product" "$activation_id" > "$payload"
  printf '%s' "$signature" | base64 -d > "$signature_file" 2>/dev/null || fail "Firma Base64 inválida."
  openssl dgst -sha256 -verify "$public_key" -signature "$signature_file" "$payload" >/dev/null \
    || fail "Firma RSA inválida."

  atomic_update_lease "$lease"
  [[ "${1:-}" == --quiet ]] || printf 'Activación renovada hasta %s\n' "$lease"
}

case "${1:-status}" in
  status) show_status ;;
  renew) renew_lease "${2:-}" ;;
  remaining) load_state; printf 'permanente\n' ;;
  reseller) show_reseller ;;
  *) printf 'Uso: hextunnel-license {status|renew|remaining|reseller}\n' >&2; exit 2 ;;
esac
