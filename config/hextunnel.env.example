# Copiar a /etc/hextunnel/hextunnel.env y aplicar chmod 600.

# Plataforma. La edición de producción está validada en Debian 12,
# Ubuntu 22.04/24.04 y amd64. No habilitar en servidores comerciales.
HEXTUNNEL_ALLOW_UNTESTED_PLATFORM=0
HEXTUNNEL_MIN_RAM_KB=524288
HEXTUNNEL_MIN_DISK_KB=1048576

HEXTUNNEL_DOMAIN=""
HEXTUNNEL_ADMIN_IP=""
HEXTUNNEL_ALLOW_ROOT_PASSWORD=0
HEXTUNNEL_WEBMIN_PUBLIC=0
HEXTUNNEL_WEBMIN_PORT=10000

HEXTUNNEL_XRAY_VERSION="v26.3.27"
HEXTUNNEL_HYSTERIA2_VERSION="app/v2.9.3"

# Distribución privada. Estas variables también pueden fijarse en el comando
# público que entrega el bot; nunca se incluye la key directamente en ese comando.
HEXTUNNEL_DISTRIBUTION_ENDPOINT=""
HEXTUNNEL_LICENSE_PUBLIC_KEY_URL=""
HEXTUNNEL_LICENSE_PUBLIC_KEY_SHA256=""
HEXTUNNEL_LICENSE_PUBLIC_KEY="/etc/hextunnel/license-public.pem"

# Dependencias externas.
# El paquete de release incluye config/component-lock.env con versiones, URLs y
# SHA-256 verificados. No definas estas variables aquí salvo que quieras sustituir
# conscientemente un componente y también proporciones su checksum correcto.
# HEXTUNNEL_UDP_CUSTOM_REF=""
# HEXTUNNEL_UDP_CUSTOM_BINARY_URL=""
# HEXTUNNEL_UDP_CUSTOM_SHA256=""
# HEXTUNNEL_BADVPN_REF=""
# HEXTUNNEL_BADVPN_SOURCE_URL=""
# HEXTUNNEL_BADVPN_SHA256=""
# HEXTUNNEL_SLOWDNS_REF=""
# HEXTUNNEL_SLOWDNS_BINARY_URL=""
# HEXTUNNEL_SLOWDNS_SHA256=""
# HEXTUNNEL_SINGBOX_VERSION=""
# HEXTUNNEL_SINGBOX_BINARY_URL=""
# HEXTUNNEL_SINGBOX_SHA256=""
# HEXTUNNEL_ZIVPN_VERSION=""
# HEXTUNNEL_ZIVPN_BINARY_URL=""
# HEXTUNNEL_ZIVPN_SHA256=""

# Repositorio firmado de Webmin.
HEXTUNNEL_WEBMIN_KEY_URL="https://download.webmin.com/developers-key.asc"
HEXTUNNEL_WEBMIN_KEY_ID="2D223B918916F2A2"

# SlowDNS. En producción normalmente escucha en la IP pública y UDP/53.
HEXTUNNEL_SLOWDNS_NS=""
HEXTUNNEL_SLOWDNS_LISTEN_ADDRESS=""
HEXTUNNEL_SLOWDNS_LISTEN_PORT=53

# SlipStream. Usa un dominio distinto al nameserver de SlowDNS.
HEXTUNNEL_SLIPSTREAM_DOMAIN=""
HEXTUNNEL_SLIPSTREAM_COMMIT="bc772dd07d9a136dbd7553b0da575526de207847"
HEXTUNNEL_SLIPSTREAM_DNS_ADDRESS=""
HEXTUNNEL_SLIPSTREAM_DNS_PORT=53

# Toolchain Rust aislado para compilar el commit fijado de SlipStream.
# rustup-init se descarga como binario, se verifica mediante el .sha256 oficial y no modifica PATH.
HEXTUNNEL_RUST_ROOT="/opt/hextunnel-rust"
HEXTUNNEL_RUST_TOOLCHAIN="1.97.0"
HEXTUNNEL_RUSTUP_INIT_URL=""
HEXTUNNEL_RUSTUP_INIT_SHA256_URL=""
HEXTUNNEL_RUSTUP_INIT_SHA256=""

# Rangos NAT configurables. Los puertos exentos se separan por comas.
# 36713 conserva Hysteria 2 y 36717 conserva UDP Custom cuando se instala todo.
HEXTUNNEL_HYSTERIA1_PORT=36712
HEXTUNNEL_HYSTERIA1_NAT_START=20000
HEXTUNNEL_HYSTERIA1_NAT_END=50000
HEXTUNNEL_HYSTERIA1_NAT_EXEMPT="36713,36717"
HEXTUNNEL_ZIVPN_PORT=5667
HEXTUNNEL_ZIVPN_NAT_START=6000
HEXTUNNEL_ZIVPN_NAT_END=19999
HEXTUNNEL_ZIVPN_NAT_EXEMPT=""

# Solo para pruebas manuales de fuentes que no publican digest. Mantener en 0.
HEXTUNNEL_ALLOW_UNVERIFIED_DOWNLOADS=0

# Actualizaciones: manifiesto JSON y firma .sig. Los artefactos se aceptan por HTTPS.
HEXTUNNEL_UPDATE_CHANNEL="stable"
HEXTUNNEL_STABLE_MANIFEST_URL=""
HEXTUNNEL_TESTING_MANIFEST_URL=""
HEXTUNNEL_UPDATE_PUBLIC_KEY="/etc/hextunnel/update-public.pem"
