# Copiar a /etc/hextunnel/hextunnel.env y aplicar chmod 600.
HEXTUNNEL_DOMAIN=""
HEXTUNNEL_ADMIN_IP=""
HEXTUNNEL_ALLOW_ROOT_PASSWORD=0
HEXTUNNEL_WEBMIN_PUBLIC=0

HEXTUNNEL_XRAY_VERSION="v26.3.27"
HEXTUNNEL_HYSTERIA2_VERSION="app/v2.9.3"
HEXTUNNEL_ZIVPN_VERSION="udp-zivpn_1.4.9"

HEXTUNNEL_SLOWDNS_NS=""
HEXTUNNEL_SLOWDNS_BINARY_URL="https://raw.githubusercontent.com/fisabiliyusri/SLDNS/main/slowdns/sldns-server"
HEXTUNNEL_SLOWDNS_SHA256=""
HEXTUNNEL_SLIPSTREAM_DOMAIN=""
HEXTUNNEL_SLIPSTREAM_COMMIT="bc772dd07d9a136dbd7553b0da575526de207847"

# Solo para fuentes heredadas que no publican un digest. No recomendado.
HEXTUNNEL_ALLOW_UNVERIFIED_DOWNLOADS=0

HEXTUNNEL_UPDATE_CHANNEL="stable"
HEXTUNNEL_STABLE_MANIFEST_URL=""
HEXTUNNEL_TESTING_MANIFEST_URL=""
HEXTUNNEL_UPDATE_PUBLIC_KEY="/etc/hextunnel/update-public.pem"
