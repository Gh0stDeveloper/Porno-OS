#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="${HEXTUNNEL_INSTALL_DIR:-/opt/hextunnel}"
[[ -f "$ROOT/lib/common.sh" ]] || ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
for file in common logging backup rollback systemd firewall secrets validation modules accounts; do
  source "$ROOT/lib/$file.sh"
done
HEXTUNNEL_DRY_RUN="${HEXTUNNEL_DRY_RUN:-0}"
HEXTUNNEL_NON_INTERACTIVE="${HEXTUNNEL_NON_INTERACTIVE:-0}"
init_logging
load_runtime_config
load_hextunnel_secrets
load_module_registry

usage() {
  cat <<'EOF'
hextunnel-account create <ssh|vless|vmess|trojan|hysteria2|zivpn> <usuario> <YYYY-MM-DD> [max_sessions] [quota_mb] [speed_kbps]
hextunnel-account renew <protocolo> <usuario> <YYYY-MM-DD>
hextunnel-account suspend <protocolo> <usuario>
hextunnel-account delete <protocolo> <usuario>
hextunnel-account list
EOF
}

command="${1:-help}"
shift || true
case "$command" in
  create)
    (($# >= 3)) || { usage; exit 64; }
    transaction_begin "account-create-$1-$2"
    trap 'transaction_fail "$?" "$BASH_LINENO" "$BASH_COMMAND"' ERR INT TERM
    account_create "$@"
    transaction_commit
    trap - ERR INT TERM
    ;;
  renew)
    (($# == 3)) || { usage; exit 64; }
    transaction_begin "account-renew-$1-$2"
    trap 'transaction_fail "$?" "$BASH_LINENO" "$BASH_COMMAND"' ERR INT TERM
    account_renew "$@"
    transaction_commit
    trap - ERR INT TERM
    ;;
  suspend)
    (($# == 2)) || { usage; exit 64; }
    transaction_begin "account-suspend-$1-$2"
    trap 'transaction_fail "$?" "$BASH_LINENO" "$BASH_COMMAND"' ERR INT TERM
    account_suspend "$@"
    transaction_commit
    trap - ERR INT TERM
    ;;
  delete)
    (($# == 2)) || { usage; exit 64; }
    transaction_begin "account-delete-$1-$2"
    trap 'transaction_fail "$?" "$BASH_LINENO" "$BASH_COMMAND"' ERR INT TERM
    account_delete "$@"
    transaction_commit
    trap - ERR INT TERM
    ;;
  list) account_list ;;
  help|--help|-h) usage ;;
  *) usage; exit 64 ;;
esac
