# Copiar a /etc/hextunnel/hextunnel.env y aplicar chmod 600.
HEXTUNNEL_DOMAIN=""
HEXTUNNEL_ADMIN_IP=""
HEXTUNNEL_ALLOW_ROOT_PASSWORD=0
HEXTUNNEL_WEBMIN_PUBLIC=0
HEXTUNNEL_WEBMIN_PORT=10000

HEXTUNNEL_XRAY_VERSION="v26.3.27"
HEXTUNNEL_HYSTERIA2_VERSION="app/v2.9.3"
HEXTUNNEL_SINGBOX_VERSION="1.12.22"
HEXTUNNEL_ZIVPN_VERSION="udp-zivpn_1.4.9"

# Binarios externos heredados: configurar siempre el SHA-256 obtenido de una fuente confiable.
HEXTUNNEL_UDP_CUSTOM_BINARY_URL="https://raw.githubusercontent.com/mahpud896/UDP-Custom/main/bin/udp-custom-linux-amd64"
HEXTUNNEL_UDP_CUSTOM_SHA256=""
HEXTUNNEL_BADVPN_REF="1.999.130"
HEXTUNNEL_BADVPN_SOURCE_URL="https://codeload.github.com/ambrop72/badvpn/tar.gz/refs/tags/1.999.130"
HEXTUNNEL_BADVPN_SHA256=""
HEXTUNNEL_SLOWDNS_BINARY_URL="https://raw.githubusercontent.com/fisabiliyusri/SLDNS/main/slowdns/sldns-server"
HEXTUNNEL_SLOWDNS_SHA256=""
HEXTUNNEL_ZIVPN_BINARY_URL=""
HEXTUNNEL_ZIVPN_SHA256=""
HEXTUNNEL_SINGBOX_SHA256=""

# Repositorio firmado de Webmin.
HEXTUNNEL_WEBMIN_KEY_URL="https://download.webmin.com/developers-key.asc"
HEXTUNNEL_WEBMIN_KEY_ID="2D223B918916F2A2"

# SlowDNS. En producción normalmente escucha en la IP pública y UDP/53.
HEXTUNNEL_SLOWDNS_NS=""
HEXTUNNEL_SLOWDNS_LISTEN_ADDRESS=""
HEXTUNNEL_SLOWDNS_LISTEN_PORT=53

# SlipStream. Usa un dominio distinto al nameserver de SlowDNS.
HEXTUNNEL_SLIPSTREAM_DOMAIN=""
HEXTUNNEL_SLIPSTREAM_COMMIT="bc772dd07d9a136dbd7553b0da575526de207847"
HEXTUNNEL_SLIPSTREAM_DNS_ADDRESS=""
HEXTUNNEL_SLIPSTREAM_DNS_PORT=53

# Rangos NAT configurables. Los valores predeterminados conservan el comportamiento histórico.
HEXTUNNEL_HYSTERIA1_PORT=36712
HEXTUNNEL_HYSTERIA1_NAT_START=20000
HEXTUNNEL_HYSTERIA1_NAT_END=50000
HEXTUNNEL_HYSTERIA1_NAT_EXEMPT=36713
HEXTUNNEL_ZIVPN_PORT=5667
HEXTUNNEL_ZIVPN_NAT_START=6000
HEXTUNNEL_ZIVPN_NAT_END=19999
HEXTUNNEL_ZIVPN_NAT_EXEMPT=""

# Solo para fuentes heredadas que no publican un digest. No recomendado.
HEXTUNNEL_ALLOW_UNVERIFIED_DOWNLOADS=0

HEXTUNNEL_UPDATE_CHANNEL="stable"
HEXTUNNEL_STABLE_MANIFEST_URL=""
HEXTUNNEL_TESTING_MANIFEST_URL=""
HEXTUNNEL_UPDATE_PUBLIC_KEY="/etc/hextunnel/update-public.pem"
