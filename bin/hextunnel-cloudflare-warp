#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ACTION="${1:-install}"
ROOT="${HEXTUNNEL_PACKAGE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PACKAGE_MANAGER="${HEXTUNNEL_PACKAGE_MANAGER:-$ROOT/bin/hextunnel-package-manager}"
TMP_DIR="${HEXTUNNEL_TMP_DIR:-/tmp}"
REPO_URL="${HEXTUNNEL_WARP_REPO_URL:-https://pkg.cloudflareclient.com}"
KEY_URL="${HEXTUNNEL_WARP_KEY_URL:-https://pkg.cloudflareclient.com/pubkey.gpg}"
KEY_ID="${HEXTUNNEL_WARP_KEY_ID:-6E2DD2174FA1C3BA}"
SOURCE_FILE="${HEXTUNNEL_WARP_SOURCE_FILE:-/etc/apt/sources.list.d/cloudflare-client.list}"
KEYRING_FILE="${HEXTUNNEL_WARP_KEYRING_FILE:-/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg}"
STATE_DIR="${HEXTUNNEL_WARP_STATE_DIR:-/var/lib/hextunnel/warp}"
PROXY_PORT="${HEXTUNNEL_WARP_PROXY_PORT:-40000}"
WARP_WORK=''
trap 'rm -rf "${WARP_WORK:-}"' EXIT

warp_log_step() {
  if declare -F _hex_runtime_step >/dev/null 2>&1; then
    _hex_runtime_step "$*"
  else
    printf '[•] %s\n' "$*" >&2
  fi
}

warp_log_ok() {
  if declare -F _hex_runtime_ok >/dev/null 2>&1; then
    _hex_runtime_ok "$*"
  else
    printf '[✓] %s\n' "$*" >&2
  fi
}

warp_log_warn() {
  printf '[!] %s\n' "$*" >&2
}

warp_die() {
  printf '[✗] %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ "${EUID:-$(id -u)}" -eq 0 ]] || warp_die 'La reparación de Cloudflare WARP requiere root.'
}

prepare_shared_tmp() {
  local mode owner group repaired=0

  if [[ ! -d "$TMP_DIR" ]]; then
    install -d -m 1777 "$TMP_DIR"
    repaired=1
  fi

  mode="$(stat -c '%a' "$TMP_DIR" 2>/dev/null || printf unknown)"
  if [[ "$mode" != 1777 ]]; then
    chmod 1777 "$TMP_DIR" || warp_die "No se pudieron restaurar los permisos 1777 de $TMP_DIR."
    repaired=1
  fi

  if [[ "$TMP_DIR" == /tmp ]]; then
    owner="$(stat -c '%U' "$TMP_DIR" 2>/dev/null || printf unknown)"
    group="$(stat -c '%G' "$TMP_DIR" 2>/dev/null || printf unknown)"
    if [[ "$owner" != root || "$group" != root ]]; then
      chown root:root "$TMP_DIR" || warp_die 'No se pudo restaurar root:root en /tmp.'
      repaired=1
    fi
  fi

  ((repaired == 0)) || warp_log_warn "Se restauró $TMP_DIR con permisos compartidos 1777 antes de usar APT."
}

run_package_manager() {
  [[ -x "$PACKAGE_MANAGER" ]] || warp_die "No se encontró el gestor de paquetes seguro: $PACKAGE_MANAGER"
  "$PACKAGE_MANAGER" "$@"
}

backup_file() {
  local path="$1" label="$2" stamp destination
  [[ -e "$path" ]] || return 0
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  install -d -m 0700 "$STATE_DIR/backups"
  destination="$STATE_DIR/backups/${label}.${stamp}"
  cp -a -- "$path" "$destination"
}

remove_managed_repository() {
  if [[ -e "$SOURCE_FILE" ]]; then
    if ! grep -Fq "$REPO_URL" "$SOURCE_FILE"; then
      warp_die "El archivo $SOURCE_FILE existe, pero no pertenece al repositorio oficial de Cloudflare."
    fi
    backup_file "$SOURCE_FILE" cloudflare-client.list
    rm -f -- "$SOURCE_FILE"
  fi

  if [[ -e "$KEYRING_FILE" ]]; then
    backup_file "$KEYRING_FILE" cloudflare-warp-keyring.gpg
    rm -f -- "$KEYRING_FILE"
  fi
}

cleanup_stale_repository() {
  warp_log_step 'Retirando configuraciones incompletas de Cloudflare WARP'
  remove_managed_repository
  warp_log_ok 'Repositorio temporal de Cloudflare preparado'
}

apt_recover() {
  cleanup_stale_repository
  warp_log_step 'Comprobando que APT continúe operativo'
  run_package_manager apt-get update
  warp_log_ok 'APT volvió a un estado utilizable'
}

resolve_codename() {
  local codename="${HEXTUNNEL_WARP_CODENAME:-}"
  if [[ -z "$codename" && -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    codename="${VERSION_CODENAME:-}"
  fi
  if [[ -z "$codename" ]] && command -v lsb_release >/dev/null 2>&1; then
    codename="$(lsb_release -cs)"
  fi
  case "$codename" in
    noble|jammy|bookworm|trixie|resolute) printf '%s' "$codename" ;;
    *) warp_die "Cloudflare WARP no tiene un repositorio validado para: ${codename:-desconocido}." ;;
  esac
}

validate_downloaded_key() {
  local key_file="$1" fingerprints
  gpg --batch --show-keys --with-colons "$key_file" >/dev/null 2>&1 \
    || warp_die 'La clave descargada de Cloudflare no es un archivo OpenPGP válido.'

  fingerprints="$(gpg --batch --show-keys --with-colons "$key_file" 2>/dev/null \
    | awk -F: '$1 == "fpr" {print toupper($10)}')"
  grep -Eq "${KEY_ID^^}$" <<< "$fingerprints" \
    || warp_die "La clave oficial descargada no contiene el identificador esperado $KEY_ID."
}

write_repository() {
  local codename="$1" source_tmp
  install -d -m 0755 "$(dirname "$SOURCE_FILE")"
  source_tmp="$(mktemp "$(dirname "$SOURCE_FILE")/.cloudflare-client.list.XXXXXX")"
  printf 'deb [arch=%s signed-by=%s] %s/ %s main\n' \
    "$(dpkg --print-architecture)" "$KEYRING_FILE" "$REPO_URL" "$codename" > "$source_tmp"
  chmod 0644 "$source_tmp"
  mv -f -- "$source_tmp" "$SOURCE_FILE"
}

wait_for_warp_service() {
  local attempt
  for attempt in {1..30}; do
    if warp-cli --accept-tos status >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

wait_for_proxy_listener() {
  local attempt
  for attempt in {1..30}; do
    if ss -H -ltn "sport = :$PROXY_PORT" 2>/dev/null | grep -q .; then
      return 0
    fi
    sleep 1
  done
  return 1
}

configure_warp_proxy() {
  warp_log_step 'Configurando Cloudflare WARP como proxy local'
  systemctl enable --now warp-svc
  wait_for_warp_service || warp_die 'warp-svc inició, pero warp-cli no respondió dentro del tiempo esperado.'

  if ! warp-cli --accept-tos registration show >/dev/null 2>&1; then
    warp-cli --accept-tos registration new
  fi

  warp-cli --accept-tos tunnel protocol set MASQUE >/dev/null 2>&1 \
    || warp_log_warn 'No se pudo fijar MASQUE explícitamente; se conservará el protocolo predeterminado de WARP.'
  warp-cli --accept-tos mode proxy
  warp-cli --accept-tos proxy port "$PROXY_PORT"
  warp-cli --accept-tos connect

  wait_for_proxy_listener \
    || warp_die "WARP no abrió el proxy local esperado en 127.0.0.1:$PROXY_PORT."
  warp_log_ok "Cloudflare WARP disponible en el proxy local $PROXY_PORT"
}

install_warp() {
  local key_asc key_gpg codename status
  prepare_shared_tmp
  WARP_WORK="$(mktemp -d "$TMP_DIR/hextunnel-warp.XXXXXX")"
  key_asc="$WARP_WORK/cloudflare.gpg"
  key_gpg="$WARP_WORK/cloudflare-keyring.gpg"

  apt_recover

  warp_log_step 'Instalando dependencias de Cloudflare WARP'
  run_package_manager apt-get install -y ca-certificates curl gnupg lsb-release

  warp_log_step 'Descargando y verificando la clave oficial de Cloudflare'
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
    --location --retry 3 --retry-delay 2 "$KEY_URL" -o "$key_asc"
  validate_downloaded_key "$key_asc"
  gpg --batch --yes --dearmor --output "$key_gpg" "$key_asc"
  install -d -m 0755 "$(dirname "$KEYRING_FILE")"
  install -m 0644 "$key_gpg" "$KEYRING_FILE"

  codename="$(resolve_codename)"
  write_repository "$codename"

  warp_log_step 'Validando el repositorio oficial de Cloudflare'
  if run_package_manager apt-get update; then
    :
  else
    status=$?
    warp_log_warn 'El repositorio de Cloudflare no superó la validación de APT; se retirará para no dañar futuras actualizaciones.'
    remove_managed_repository
    run_package_manager apt-get update || true
    return "$status"
  fi

  run_package_manager apt-get install -y cloudflare-warp
  command -v warp-cli >/dev/null 2>&1 || warp_die 'cloudflare-warp terminó de instalarse, pero warp-cli no existe.'
  command -v ss >/dev/null 2>&1 || warp_die 'No se encontró ss para validar el proxy local de WARP.'
  configure_warp_proxy

  install -d -m 0700 "$STATE_DIR"
  printf 'repository=%s\nkeyring=%s\nproxy_port=%s\ninstalled_at=%s\n' \
    "$SOURCE_FILE" "$KEYRING_FILE" "$PROXY_PORT" "$(date -u +%FT%TZ)" \
    > "$STATE_DIR/state.env"
  chmod 0600 "$STATE_DIR/state.env"
}

require_root
case "$ACTION" in
  cleanup)
    cleanup_stale_repository
    ;;
  repair)
    prepare_shared_tmp
    apt_recover
    ;;
  install)
    install_warp
    ;;
  *)
    warp_die 'Uso: hextunnel-cloudflare-warp {cleanup|repair|install}'
    ;;
esac
