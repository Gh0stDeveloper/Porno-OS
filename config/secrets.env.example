# Copiar a /etc/hextunnel/secrets.env y aplicar chmod 600.
# El token y Chat ID siguen disponibles dentro del sistema mediante estas variables.
HEXTUNNEL_TELEGRAM_CHAT_ID=""
HEXTUNNEL_TELEGRAM_BOT_TOKEN=""

# Cuando están vacíos, el instalador genera valores aleatorios únicos por VPS.
HEXTUNNEL_HYSTERIA2_PASSWORD=""
HEXTUNNEL_HYSTERIA2_OBFS=""
HEXTUNNEL_ZIVPN_PASSWORD=""
HEXTUNNEL_ZIVPN_OBFS=""
