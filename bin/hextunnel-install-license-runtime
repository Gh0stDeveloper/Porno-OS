#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ "${EUID:-$(id -u)}" -eq 0 ]] || { echo "ERROR: se requiere root." >&2; exit 1; }
ROOT="${HEXTUNNEL_INSTALL_DIR:-/opt/hextunnel}"
[[ -x "$ROOT/bin/hextunnel-license" ]] || {
  SOURCE_ROOT="${HEXTUNNEL_PRIVATE_PACKAGE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"
  [[ -x "$SOURCE_ROOT/bin/hextunnel-license" ]] || { echo "ERROR: falta hextunnel-license." >&2; exit 1; }
  ROOT="$SOURCE_ROOT"
}

install -d -m 0755 /usr/local/bin /usr/local/lib/hextunnel
ln -sfn "$ROOT/bin/hextunnel-license" /usr/local/bin/hextunnel-license

cat > /usr/local/bin/hextunnel-upgrade <<'SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail
[[ "${EUID:-$(id -u)}" -eq 0 ]] || { echo "ERROR: usa sudo hextunnel-upgrade." >&2; exit 1; }
command -v curl >/dev/null 2>&1 || {
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y --no-install-recommends curl ca-certificates
}
tmp="$(mktemp /tmp/hextunnel-upgrade.XXXXXX.sh)"
trap 'rm -f "$tmp"' EXIT
curl -fsSL --retry 2 --connect-timeout 8 --max-time 60 \
  https://ghostdeveloper.duckdns.org/install.sh -o "$tmp"
bash -n "$tmp"
chmod 700 "$tmp"
exec bash "$tmp" upgrade "$@"
SCRIPT
chmod 0755 /usr/local/bin/hextunnel-upgrade

architecture="$(uname -m)"
case "$architecture" in
  aarch64|arm64)
    [[ -x "$ROOT/bin/hextunnel-arm64-menu" ]] \
      || { echo "ERROR: falta el menú ARM64 en $ROOT." >&2; exit 1; }
    install -m 0755 "$ROOT/bin/hextunnel-arm64-menu" /usr/local/bin/menu.new
    mv -f /usr/local/bin/menu.new /usr/local/bin/menu
    ;;
  x86_64|amd64)
    if [[ -x /usr/local/bin/menu ]] \
      && ! grep -q 'HEXTUNNEL_BRANDED_MENU=1' /usr/local/bin/menu 2>/dev/null; then
      if [[ ! -x /usr/local/lib/hextunnel/menu-original ]]; then
        mv /usr/local/bin/menu /usr/local/lib/hextunnel/menu-original
      else
        rm -f /usr/local/bin/menu
      fi
    fi

    if [[ -x /usr/local/lib/hextunnel/menu-original ]]; then
      cat > /usr/local/bin/menu.new <<'SCRIPT'
#!/usr/bin/env bash
# HEXTUNNEL_BRANDED_MENU=1
set -Eeuo pipefail
command -v clear >/dev/null 2>&1 && clear || true
printf '\033[1;36m============================================================\033[0m\n'
printf '\033[1;37m                       HEX TUNNEL\033[0m\n'
printf '\033[0;36m          @Gh0stDeveloper  ·  @Jotchua_DevzZ\033[0m\n'
if [[ -x /usr/local/bin/hextunnel-license ]]; then
  printf '\033[0;32mLicencia restante: %s\033[0m\n' \
    "$(/usr/local/bin/hextunnel-license remaining 2>/dev/null || printf desconocido)"
fi
printf '\033[1;36m============================================================\033[0m\n\n'
exec /usr/local/lib/hextunnel/menu-original "$@"
SCRIPT
      chmod 0755 /usr/local/bin/menu.new
      mv -f /usr/local/bin/menu.new /usr/local/bin/menu
    fi
    ;;
  *)
    echo "ERROR: arquitectura no soportada por el runtime: $architecture" >&2
    exit 1
    ;;
esac

cat > /etc/systemd/system/hextunnel-license-renew.service <<'UNIT'
[Unit]
Description=Renovar autorización firmada de Hex Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hextunnel-license renew --quiet
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/opt/hextunnel
ReadWritePaths=/etc/hextunnel
LockPersonality=true
RestrictSUIDSGID=true
UNIT

cat > /etc/systemd/system/hextunnel-license-renew.timer <<'UNIT'
[Unit]
Description=Renovación periódica de licencia Hex Tunnel

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now hextunnel-license-renew.timer >/dev/null
