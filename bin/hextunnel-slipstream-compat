#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

compat_error() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "${EUID:-$(id -u)}" -eq 0 ]] || compat_error "SlipStream debe instalarse como root."
DOMAIN="${1:-}"
SLOWDNS_NS="${2:-}"
[[ "$DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]] || compat_error "Dominio SlipStream inválido."
[[ "$SLOWDNS_NS" =~ ^[A-Za-z0-9.-]+$ ]] || compat_error "Nameserver SlowDNS inválido."
[[ "$DOMAIN" != "$SLOWDNS_NS" ]] || compat_error "Los dominios de SlowDNS y SlipStream deben ser diferentes."

ROOT="${HEXTUNNEL_INSTALL_DIR:-/opt/hextunnel}"
[[ -f "$ROOT/lib/common.sh" ]] || ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
for file in common logging backup rollback systemd firewall nat secrets validation modules framework; do
  # shellcheck disable=SC1090
  source "$ROOT/lib/$file.sh"
done
init_logging
load_runtime_config
load_hextunnel_secrets
load_module_registry

HEXTUNNEL_SLIPSTREAM_DOMAIN="$DOMAIN"
HEXTUNNEL_SLOWDNS_NS="$SLOWDNS_NS"
HEXTUNNEL_NON_INTERACTIVE=1
HEXTUNNEL_NO_REBOOT=1
HEXTUNNEL_FORCE=1
export HEXTUNNEL_SLIPSTREAM_DOMAIN HEXTUNNEL_SLOWDNS_NS
export HEXTUNNEL_NON_INTERACTIVE HEXTUNNEL_NO_REBOOT HEXTUNNEL_FORCE

validate_operating_system
validate_architecture
validate_system_state
validate_resources
validate_connectivity
firewall_prepare_backend
transaction_begin slipstream-compat
trap 'transaction_fail "$?" "$LINENO" "$BASH_COMMAND"' ERR INT TERM
firewall_snapshot
install_framework
if ! module_is_installed slowdns; then
  module_install slowdns
fi
if ! module_is_installed slipstream; then
  module_install slipstream
fi
transaction_commit
trap - ERR INT TERM

printf 'SlipStream instalado mediante los módulos mantenidos de SlowDNS y SlipStream.\n'
