#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="${HEXTUNNEL_INSTALL_DIR:-/opt/hextunnel}"
[[ -f "$ROOT/lib/common.sh" ]] || ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
for file in common logging backup rollback systemd firewall secrets validation modules; do source "$ROOT/lib/$file.sh"; done
init_logging; load_runtime_config; load_hextunnel_secrets; load_module_registry
usage() { printf '%s\n' 'hextunnel doctor [--report archivo]' 'hextunnel status' 'hextunnel install <modulo...>' 'hextunnel uninstall <modulo|--all>' 'hextunnel rollback [id]' 'hextunnel legacy-menu'; }
doctor() { local report="${1:-}" output tmp module; tmp="$(mktemp /tmp/hextunnel-doctor.XXXXXX)"; { echo "Hex Tunnel Doctor"; echo "Fecha: $(date -Is)"; echo "Host: $(hostname)"; echo "OS: $(. /etc/os-release; echo "$PRETTY_NAME")"; echo "Arquitectura: $(uname -m)"; echo "Kernel: $(uname -r)"; echo "Uptime: $(uptime -p 2>/dev/null || true)"; echo "RAM:"; free -h || true; echo "Disco:"; df -h / || true; echo "Firewall: $(firewall_backend)"; echo "Puertos:"; ss -lntup || true; echo "Certificados:"; find /etc/xray /etc/hysteria2 -maxdepth 2 -type f \( -name '*.crt' -o -name '*.pem' \) -print 2>/dev/null | while read -r cert; do openssl x509 -in "$cert" -noout -subject -enddate 2>/dev/null || true; done; for module in "${HEXTUNNEL_AVAILABLE_MODULES[@]}"; do [[ "$module" == legacy-all ]] && continue; echo; echo "[$module]"; module_doctor "$module" || true; done; echo; echo "Errores recientes:"; journalctl -p err -n 80 --no-pager 2>/dev/null || true; } | sanitize_text > "$tmp"; output="${report:-$HEXTUNNEL_LOG_DIR/doctor-$(date +%Y%m%d-%H%M%S).txt}"; install -m 600 "$tmp" "$output"; rm -f "$tmp"; printf 'Reporte generado: %s\n' "$output"; }
case "${1:-help}" in doctor) shift; [[ "${1:-}" == --report ]] && { shift; doctor "${1:-}"; } || doctor ;; status) for module in "${HEXTUNNEL_AVAILABLE_MODULES[@]}"; do [[ "$module" == legacy-all ]] || { printf '%-14s ' "$module"; module_doctor "$module" || true; }; done ;; install) shift; exec "$ROOT/install.sh" install "$@" ;; uninstall) shift; exec "$ROOT/install.sh" uninstall "$@" ;; rollback) shift; rollback_transaction "${1:-}" ;; legacy-menu) [[ -x /usr/local/bin/menu ]] && exec /usr/local/bin/menu || die "El menú heredado no está instalado." ;; help|--help|-h) usage ;; *) die "Comando desconocido: ${1:-}" ;; esac
